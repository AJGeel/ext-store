{
  "name": "@ajgeel/ext-store",
  "version": "0.1.1",
  "description": "Submit browser extensions to the Chrome Web Store and Firefox Add-ons.",
  "keywords": [
    "chrome-web-store",
    "firefox",
    "addons",
    "amo",
    "web-extension",
    "browser-extension",
    "publish",
    "cli"
  ],
  "author": "Arthur Geel <ageel@enrise.com>",
  "license": "MIT",
  "homepage": "https://github.com/AJGeel/ext-store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJGeel/ext-store.git"
  },
  "bugs": {
    "url": "https://github.com/AJGeel/ext-store/issues"
  },
  "type": "module",
  "bin": {
    "ext-store": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./firefox": "./src/firefox.ts",
    "./ui": "./src/ui.ts",
    "./utils": "./src/utils.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "jsonwebtoken": "^9.0.3",
    "picocolors": "1.1.1"
  },
  "peerDependencies": {
    "web-ext": "^8.10.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^6.0.3",
    "web-ext": "^8.10.0"
  }
}
