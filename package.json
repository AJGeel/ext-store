{
  "name": "@ajgeel/ext-store",
  "version": "0.1.2",
  "description": "Submit browser extensions to the Chrome Web Store and Firefox Add-ons.",
  "keywords": [
    "chrome-web-store",
    "firefox",
    "addons",
    "amo",
    "web-extension",
    "browser-extension",
    "publish",
    "cli"
  ],
  "author": "Arthur Geel <ageel@enrise.com>",
  "license": "MIT",
  "homepage": "https://github.com/AJGeel/ext-store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJGeel/ext-store.git"
  },
  "bugs": {
    "url": "https://github.com/AJGeel/ext-store/issues"
  },
  "type": "module",
  "bin": {
    "ext-store": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./firefox": "./src/stores/firefox.ts",
    "./ui": "./src/lib/ui.ts",
    "./utils": "./src/lib/utils.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "release": "bun src/cli.ts tag-release",
    "prepublishOnly": "bun run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "jsonwebtoken": "^9.0.3",
    "picocolors": "1.1.1"
  },
  "peerDependencies": {
    "web-ext": "^10.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "web-ext": "^10.7.0"
  }
}
